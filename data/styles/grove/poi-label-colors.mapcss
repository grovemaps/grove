area[amenity=hospital],
node[amenity=clinic],
node[amenity=dentist],
node[amenity=doctors],
node[amenity=hospital],
node[amenity=pharmacy],
node[amenity=veterinary],
node[healthcare],
{text-color: @healthcare_label;text-halo-radius: 0.1;text-halo-opacity: 1;text-halo-color: @label_halo_light;}

