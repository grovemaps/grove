node[emergency=access_point],
{text-color: @emergency_label;text-halo-radius: 0.1;text-halo-opacity: 1;text-halo-color: @label_halo_light;}

/* ---- Grove additions ---- */

/* Apple Maps colors museums like entertainment venues; landmarks keep @culture_label. */
node[amenity=arts_centre],
node[tourism=gallery],
node[tourism=museum],
{text-color: @entertainment_label;}

/* Apple Maps gives education its own color. */
area[amenity=university][name],
node[amenity=childcare],
node[amenity=college],
node[amenity=driving_school],
node[amenity=kindergarten],
node[amenity=language_school],
node[amenity=library],
node[amenity=music_school],
node[amenity=school],
node[amenity=university][name],
{text-color: @education_label;}

/* Types Organic Maps has but CoMaps removed. */
node[amenity=hookah_lounge],
{text-color: @food_label;text-halo-radius: 0.1;text-halo-opacity: 1;text-halo-color: @label_halo_light;}

node[attraction=amusement_ride],
node[attraction=big_wheel],
node[attraction=bumper_car],
node[attraction=carousel],
node[attraction=maze],
node[attraction=roller_coaster],
{text-color: @entertainment_label;text-halo-radius: 0.1;text-halo-opacity: 1;text-halo-color: @label_halo_light;}

node[amenity=student_accommodation],
{text-color: @hotel_label;text-halo-radius: 0.1;text-halo-opacity: 1;text-halo-color: @label_halo_light;}

node[leisure=bird_hide],
{text-color: @nature_label;text-halo-radius: 0.1;text-halo-opacity: 1;text-halo-color: @label_halo_light;}

node[amenity=kneipp_water_cure],
{text-color: @water_light_label;text-halo-radius: 0.1;text-halo-opacity: 1;text-halo-color: @label_halo_light;}

/* Apple Maps shows landmarks and monuments in the landmark color; CoMaps only covers a few castle types. */
node[historic=aircraft],
node[historic=anchor],
node[historic=archaeological_site],
node[historic=battlefield],
node[historic=cannon],
node[historic=castle],
node[historic=city_gate],
node[historic=citywalls],
node[historic=fort],
node[historic=locomotive],
node[historic=memorial],
node[historic=monument],
node[historic=ruins],
node[historic=tank],
node[historic=tomb],
node[historic=wreck],
{text-color: @culture_label;text-halo-radius: 0.1;text-halo-opacity: 1;text-halo-color: @label_halo_light;}
