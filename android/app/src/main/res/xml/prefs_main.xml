    <SwitchPreferenceCompat android:key="@string/pref_search_history" android:title="@string/search_history_title" app:singleLineTitle="false" android:defaultValue="true" android:order="6" />
  </androidx.preference.PreferenceCategory>
  <androidx.preference.PreferenceCategory android:key="grove_group_app" android:order="14" android:visible="false" app:iconSpaceReserved="false">
