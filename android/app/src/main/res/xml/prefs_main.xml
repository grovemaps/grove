    <SwitchPreferenceCompat android:key="@string/pref_auto_night_in_navigation" android:title="@string/pref_auto_night_in_navigation_title" app:singleLineTitle="false" android:order="5" />
    <SwitchPreferenceCompat android:key="GroveCycleRoutes" android:title="@string/pref_prefer_cycle_routes_title" android:summary="@string/pref_prefer_cycle_routes_summary" app:singleLineTitle="false" android:persistent="false" android:order="6" />
    <PreferenceScreen android:key="@string/prefs_routing" android:title="@string/driving_options_title" android:order="7">
      <intent android:targetClass="app.organicmaps.settings.DrivingOptionsActivity" android:targetPackage="@string/app_id">
        <extra android:name="from" android:value="settings" />
      </intent>
    </PreferenceScreen>
  </androidx.preference.PreferenceCategory>
  <androidx.preference.PreferenceCategory android:key="grove_group_places" android:order="12" android:visible="false" app:iconSpaceReserved="false">
    <app.organicmaps.settings.GroveSectionPreference android:key="grove_hero_places" android:summary="@string/grove_settings_places_summary" android:selectable="false" android:persistent="false" android:order="1" />
    <SwitchPreferenceCompat android:key="GroveReviews" android:title="@string/reviews_by_mangrove" android:summary="@string/pref_mangrove_reviews_summary" app:singleLineTitle="false" android:persistent="false" android:order="2" />
