  <androidx.preference.PreferenceCategory android:key="grove_group_map" android:order="10" android:visible="false" app:iconSpaceReserved="false">
    <app.organicmaps.settings.GroveSectionPreference android:key="grove_hero_map" android:summary="@string/grove_settings_map_summary" android:selectable="false" android:persistent="false" android:order="1" />
    <ListPreference android:key="GroveLook" android:title="@string/pref_map_look_title" app:singleLineTitle="false" android:entries="@array/grove_looks" android:entryValues="@array/grove_look_values" android:persistent="false" android:order="2" />
