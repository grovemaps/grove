<?xml version="1.0" encoding="utf-8"?>
<!-- Grove: settings in sections. The start page shows the section cards; a section's page shows its group, headed by
     an illustration. Every page holds all preferences, hidden but for its own, so upstream's setup code finds them;
     see GroveSettings.showSection. -->
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
  <Preference android:key="@string/pref_osm_profile" android:title="@string/profile" tools:summary="LongLongUsernameHere" app:singleLineTitle="false" android:order="1" />
  <app.organicmaps.settings.GroveSectionPreference android:key="grove_section_map" android:title="@string/grove_settings_map_title" android:summary="@string/grove_settings_map_summary" android:order="2" android:persistent="false" />
  <app.organicmaps.settings.GroveSectionPreference android:key="grove_section_navigation" android:title="@string/grove_settings_navigation_title" android:summary="@string/grove_settings_navigation_summary" android:order="3" android:persistent="false" />
  <app.organicmaps.settings.GroveSectionPreference android:key="grove_section_places" android:title="@string/grove_settings_places_title" android:summary="@string/grove_settings_places_summary" android:order="4" android:persistent="false" />
  <app.organicmaps.settings.GroveSectionPreference android:key="grove_section_privacy" android:title="@string/grove_settings_privacy_title" android:summary="@string/grove_settings_privacy_summary" android:order="5" android:persistent="false" />
