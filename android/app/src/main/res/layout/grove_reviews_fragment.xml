<?xml version="1.0" encoding="utf-8"?>
<!-- Grove: Mangrove reviews of the place, see GroveReviewsFragment. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">
  <LinearLayout
    style="@style/PlacePageItemFrame"
    android:background="@null"
    android:clickable="false"
    android:visibility="visible">
    <ImageView
      style="@style/PlacePageMetadataIcon"
      app:srcCompat="@drawable/ic_edit"
      app:tint="?colorAccent" />
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/reviews_by_mangrove"
      android:textAppearance="@style/MwmTextAppearance.Body3" />
    <TextView
      android:id="@+id/grove_reviews_summary"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textAppearance="@style/MwmTextAppearance.Body3"
      tools:text="★ 4.5 (3)" />
  </LinearLayout>
  <LinearLayout
    android:id="@+id/grove_reviews_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" />
  <LinearLayout
    android:id="@+id/grove_reviews_write"
    style="@style/PlacePageItemFrame"
    android:visibility="visible">
    <TextView
      android:id="@+id/grove_reviews_write_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="@style/MwmTextAppearance.PlacePage.Accent"
      tools:text="Add a Review via Mangrove" />
  </LinearLayout>
</LinearLayout>
